#!/bin/sh
# >>> BRIDGEFORGE_CODEX_MANAGED_BEGIN
# BridgeForge Rust-only pre-commit hard gate. Every nonzero result blocks.

receipt_schema_is_current() {
  while IFS= read -r LINE; do
    case "$LINE" in
      '  "schema_version": 2,'|'  "schema_version": 2') return 0 ;;
    esac
  done < "$1"
  return 1
}

find_rust_tools() {
  for RECEIPT in .codex/bin/build-receipt-hook.json .codex/bin/build-receipt-cli.json; do
    if [ ! -f "$RECEIPT" ] || ! receipt_schema_is_current "$RECEIPT"; then
      echo "[pre-commit] BLOCKED: managed Rust runtime receipt is missing or obsolete; rerun \$bridgeforge-codex." >&2
      return 2
    fi
  done
  for CLI in .codex/bin/bridgeforge.exe .codex/bin/bridgeforge; do
    [ -f "$CLI" ] && BRIDGEFORGE="$CLI"
  done
  for HOOK in .codex/bin/bridgeforge-hook.exe .codex/bin/bridgeforge-hook; do
    [ -f "$HOOK" ] && BRIDGEFORGE_HOOK="$HOOK"
  done
  [ -n "$BRIDGEFORGE" ] && [ -n "$BRIDGEFORGE_HOOK" ] && return 0
  echo "[pre-commit] BLOCKED: managed Rust runtime is missing; rerun \$bridgeforge-codex." >&2
  return 2
}

run_cli() {
  "$BRIDGEFORGE" "$@"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "[pre-commit] BLOCKED: bridgeforge failed with status $rc: $*" >&2
    exit "$rc"
  fi
}

run_hook() {
  BRIDGEFORGE_HOOK_ROOT="$PWD" "$BRIDGEFORGE_HOOK" "$@"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "[pre-commit] BLOCKED: bridgeforge-hook failed with status $rc: $*" >&2
    exit "$rc"
  fi
}

find_rust_tools || exit $?
run_cli check instruction-source
run_hook config-health --strict
run_cli check baseline --root .
run_cli check baseline --root . --index
run_hook encoding --pre-commit
run_cli check project-structure --root .
run_cli check skill-metadata --root .

