{
  "description": "bridgeforge-codex project lifecycle hooks. This is the only managed Codex hook registration source.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|shell_command|Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "bridgeforgeCodexId": "bridgeforge-codex.project-hook.v1:pre-tool",
            "command": ".codex/bin/bridgeforge-hook pre-tool",
            "commandWindows": ".codex\\bin\\bridgeforge-hook.exe pre-tool",
            "comment": "Sequential dispatcher for shell safety guards and apply_patch write boundaries."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "bridgeforgeCodexId": "bridgeforge-codex.project-hook.v1:post-edit",
            "command": ".codex/bin/bridgeforge-hook post-edit",
            "commandWindows": ".codex\\bin\\bridgeforge-hook.exe post-edit",
            "comment": "Normalizes apply_patch payloads and runs dependent edit checks in an explicit order."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|shell_command",
        "hooks": [
          {
            "type": "command",
            "bridgeforgeCodexId": "bridgeforge-codex.project-hook.v1:post-shell",
            "command": ".codex/bin/bridgeforge-hook post-shell",
            "commandWindows": ".codex\\bin\\bridgeforge-hook.exe post-shell",
            "comment": "Records test-command receipts after shell execution."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "bridgeforgeCodexId": "bridgeforge-codex.project-hook.v1:post-compact",
            "command": ".codex/bin/bridgeforge-hook post-compact",
            "commandWindows": ".codex\\bin\\bridgeforge-hook.exe post-compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "bridgeforgeCodexId": "bridgeforge-codex.project-hook.v1:stop",
            "command": ".codex/bin/bridgeforge-hook stop",
            "commandWindows": ".codex\\bin\\bridgeforge-hook.exe stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "bridgeforgeCodexId": "bridgeforge-codex.project-hook.v1:session-start",
            "command": ".codex/bin/bridgeforge-hook session-start",
            "commandWindows": ".codex\\bin\\bridgeforge-hook.exe session-start",
            "additionalContextLimit": 0,
            "comment": "Validates repository runtime state, then reports cleanup and managed-skill drift."
          }
        ]
      }
    ]
  }
}
