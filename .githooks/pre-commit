#!/bin/sh
# >>> BRIDGEFORGE_CODEX_MANAGED_BEGIN
# bridgeforge current-only pre-commit 闸（严格执行序）：
#   [baseline] 工作树与 staged index 的公共骨架必须同时匹配当前合同；
#   [skills] 项目 Skill 树和 metadata 必须满足当前规则；
#
# 硬闸原则: 检查器缺失、无法启动或返回任何非零状态都必须立即阻断。
#   · 受管区与项目扩展都保留检查器的原始非零退出码。
# Project CPython 3.11+ .venv is the only runtime; steady hooks never fall back to PATH.
find_py() {
  if [ ! -e .venv ]; then
    echo "[pre-commit] BLOCKED: project .venv is missing; PATH fallback is forbidden." >&2
    return 2
  fi
  for CANDIDATE in .venv/Scripts/python.exe .venv/bin/python; do
    if [ -f "$CANDIDATE" ]; then
      if [ -f .codex/scripts/project_runtime.py ] &&
         "$CANDIDATE" .codex/scripts/project_runtime.py validate \
           --project-root . --executable "$CANDIDATE" >/dev/null 2>&1; then
        echo "$CANDIDATE"; return 0
      fi
      echo "[pre-commit] BLOCKED: project .venv must be CPython 3.11+ with a valid project prefix; PATH fallback is forbidden." >&2
      return 2
    fi
  done
  echo "[pre-commit] BLOCKED: project .venv exists but has no Python interpreter." >&2
  return 2
}
PY="$(find_py)"
PY_RC=$?
[ "$PY_RC" -ne 0 ] && exit "$PY_RC"

run_required_hook() {
  SCRIPT="$1"
  shift
  if [ -z "$PY" ]; then
    echo "[pre-commit] BLOCKED: project Python was not resolved." >&2
    exit 2
  fi
  if [ ! -f "$SCRIPT" ]; then
    echo "[pre-commit] BLOCKED: required check is missing: $SCRIPT" >&2
    exit 2
  fi
  "$PY" "$SCRIPT" "$@"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "[pre-commit] BLOCKED: required check failed with status $rc: $SCRIPT" >&2
    exit "$rc"
  fi
}

# ── [instructions] Codex 原生 AGENTS 指令源硬闸（含 staged 公共区，防 edit+restore 绕过） ──
run_required_hook ".codex/hooks/instruction_source_check.py"

# ── [hooks-source] Codex lifecycle hook 唯一注册源硬闸 ──
run_required_hook ".codex/hooks/config_health_check.py" --strict

# ── [current-baseline] 1.4.31+ 当前公共骨架漂移硬闸 ──
run_required_hook ".codex/scripts/current_baseline.py" --project-root .
run_required_hook ".codex/scripts/current_baseline.py" --project-root . --index

# [encoding] UTF-8 BOM is forbidden in bridgeforge-codex text surfaces.
run_required_hook ".codex/hooks/encoding_check.py" --pre-commit

# ── [layout] doc 五层索引 + scripts/tests 单一测试目录硬闸 ──
run_required_hook ".codex/hooks/project_structure_check.py" --pre-commit

# ── [skills] 通用 skill metadata 闸(硬拦; 下游无 skills/ 则自门控 no-op) ──
run_required_hook ".codex/hooks/skill_metadata_check.py" --pre-commit

# <<< BRIDGEFORGE_CODEX_MANAGED_END

# >>> PROJECT_EXTENSION_BEGIN
# 工厂自身额外要求产品版本 bump；该闸不下沉到 Template。
run_required_hook ".codex/scripts/factory_version_check.py"
run_required_hook "scripts/rebuild_shared_skill_manifest.py" --check
# <<< PROJECT_EXTENSION_END
